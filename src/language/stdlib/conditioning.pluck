;; suspendible-list=? : ((a, a) -> Bool, List a, List a) -> SuspendibleComputation Bool
;; Lazy pairwise list equality with suspension between elements
(define (suspendible-list=? elems=? xs ys)
  (match xs
    Nil -> (match ys
             Nil -> (Return (True))
             Cons y ys -> (Return (False)))
    Cons x xs -> (match ys
                   Nil -> (Return (False))
                   Cons y ys -> (if (elems=? x y)
                                  (Suspend (suspendible-list=? elems=? xs ys))
                                  (Return (False))))))

;; given : (Bool, a) -> a
;; Condition on predicate being true (fails if false)
(define (given p q)
  (if p q (Given)))

;; given-suspend : (SuspendibleComputation Bool, a) -> a
;; Condition with suspension support
(define (given-suspend p q)
  (match p
    Suspend x -> (Suspend (given-suspend x q))
    Return x -> (given x q)))

