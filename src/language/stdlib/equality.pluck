;;; equality.pluck - Generic equality operations

;; constructor=? : (a, b) -> Bool
;; Check if two values have the same constructor (wrapper around constructors_equal)
(define (constructor=? a b) (constructors_equal a b))

(define-type abstract_type
  (Value)
  (NativeValue type) ;; symbol representing the type
  (Closure))

;; =? : (a, b) -> Bool
;; Generic structural equality for values, native values, and closures
(define (=? a b)
  (let ((ta (abstract_type a))
        (tb (abstract_type b)))
    (and (constructor=? ta tb) ;; reject comparing value to closure, or value to native value, etc
         (match ta
            Closure => false ;; closures are never equal for now
            NativeValue _ => (native_eq a b) ;; native equality
            Value => (and (constructor=? a b) (list=? =? (get_args a) (get_args b)))))))

;; adt=? : (a, b) -> Bool
;; ADT structural equality (compares constructor and all arguments recursively)
(define (adt=? a b)
  (and (constructors_equal a b)
       (list=? adt=? (get_args a) (get_args b))))
