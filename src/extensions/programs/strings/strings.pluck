(include "name_model.pluck")
(include "surname_model.pluck")

;; Random printable ASCII character
(define (random-printable-char) (uniform_int_range @8 @32 @126))

;; (define (char=? a b) (int_dist_eq a b))
;; (define string=? (list=? char=?))
(define (random-printable-string)
  (if (flip 0.8)
    (Cons (random-printable-char) (random-printable-string))
    ""))

;; (define (random-list elem)
;;   (if (flip 0.8) (Cons (elem) (random-list elem)) []))

;; (define (random-lowercase-char) (uniform_int_range @8 @97 @122))
;; (define (random-uppercase-char) (uniform_int_range @8 @65 @90))

;; (define (random-name)
;;   (Cons (random-uppercase-char)
;;         (random-list (fn _ -> (if (flip 0.99) (random-lowercase-char) (random-uppercase-char))))))

(define (random-name) (random-string bos))
(define (random-surname) (random-string-surnames bos))

(assert-query
 'uncertain-world
 (let
  ((s1 (random-printable-string))
   (s2 (random-printable-string))
   (s (append s1 (append " " s2))))
   (Posterior
    [s1, s2]
    (string=? s "Hello uncertain world!")))
 (["Hello uncertain" "world!"] 0.5000000000000001)
 (["Hello" "uncertain world!"] 0.49999999999999994))

;; People have first and last names but sometimes we see initials
(define-type person (Person first middle last))
(define (random-person)
  (Person (random-name) (random-name) (random-surname)))
(define (render-person p)
  (match p
    Person first middle last ->
    (uniform
     first
     (Cons (car first) (append (if (flip 0.5) " " ". ") last))
     (Cons (car first) (append (if (flip 0.5) " " ". ") (Cons (car middle) (append (if (flip 0.5) " " ". ") last))))
     (Cons (car first) (Cons (car middle) (Cons (car last) "")))
     (Cons (car first) (append (uniform " " "." "") (Cons (car last) (uniform "" "."))))
     (append first (append " " last))
     (append first (append " " (append middle (append " " last))))
     (append first (append " " (Cons (car middle) (append (if (flip 0.5) " " ". ") last)))))))

(define (append-all xs)
  (match xs
    Nil -> ""
    Cons s xs -> (append s (append-all xs))))

(define (remove-spaces s)
  (filter (fn c -> (not (char=? c (car " ")))) s))

(assert-query
 'namelist
 (let
  ((num-people (geom 0.5))
   (names (map (fn i -> (render-person (random-person))) (range num-people)))
  ;;  (people (map random-person (range num-people)))
  ;;  (names (map render-person people))
   (obs (remove-spaces (append-all names))))
   (Posterior
    names ;; (map (fn p -> (match p Person f m l -> [f,m,l])) people)
    (string=? obs "EmilyJaneMcClellan")))
 (["Emily Jane McClellan"] 0.9365920405321279)
 (["Emily" "Jane McClellan"] 0.05853700253325799)
 (["Emily Jane Mc" "Clellan"] 0.004584430056107424)
 (["Emily" "Jane Mc" "Clellan"] 0.000286526878506714))

(define (trunc-geom n m)
  (match n
    O -> (Pair true m)
    S k -> (if (flip 0.3) (Pair false m) (trunc-geom k (S m)))))

(define (generate-mentions n people-so-far)
  (match n
    O -> (Pair [] people-so-far)
    S m ->
    (let
     ((idx (trunc-geom (length people-so-far) 0))
      (need-new? (fst idx))
      (person (if need-new? (random-person) (index (snd idx) people-so-far)))
      (new-mention (render-person person))
      (others (generate-mentions m (if need-new? (Cons person people-so-far) people-so-far))))
      (Pair (Cons new-mention (fst others)) (snd others)))))

