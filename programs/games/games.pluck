;;;; boolean
;; (define-type boolean (T) (F))

(define (ife c t e)
  (match c T -> t F -> e))

(define (band a b)
  (match a T -> b F -> (F)))

(define (bor a b)
  (match a T -> (T) F -> b))

(define (bnot a)
  (match a T -> (F) F -> (T)))

;;;; signed peano integers
;; (define-type int (Z) (P int) (N int))

(define (succ x)
  (match x
    Z -> (P (Z))
    P n -> (P (P n))
    N n -> n))

(define (pred x)
  (match x
    Z -> (N (Z))
    N n -> (N (N n))
    P n -> n))

(define (add a b)
  (match b
    Z -> a
    P b' -> (add (succ a) b')
    N b' -> (add (pred a) b')))

(define (int-eq a b)
  (match a
    Z -> (match b Z -> (T) P _ -> (F) N _ -> (F))
    P a' -> (match b Z -> (F) P b' -> (int-eq a' b') N _ -> (F))
    N a' -> (match b Z -> (F) P _ -> (F) N b' -> (int-eq a' b'))))

;;;; lists
;; (define-type lst (Ni) (Co any lst))

(define (hd xs)
  (match xs Co x _ -> x))

(define (nth xs n)
  (match xs
    Co x rest ->
    (match n
      Z -> x
      P n' -> (nth rest n'))))

(define (any-of pred xs)
  (match xs
    Ni -> (F)
    Co x rest -> (bor (pred x) (any-of pred rest))))

(define (map-ls f xs)
  (match xs
    Ni -> (Ni)
    Co x rest -> (Co (f x) (map-ls f rest))))

;;;; game types
;; (define-type action (U) (D) (L) (R) (X) (Despawn))
;; (define-type observable (Obs int int boolean))  ;; x y alive
;; (define-type latent (Lat boolean boolean boolean))
;; (define-type slice (Sc latent action observable))
;; (define-type kind (Kd nextlatent nextaction))
;;   nextlatent :: Latent -> Observable -> Lst State -> Latent
;;   nextaction :: Latent -> Action
;; (define-type state (St slices))
;; (define-type setup (Setup kinds states))

;; Position equality (ignores alive flag)
(define (pos-eq a b)
  (match a
    Obs ax ay _ ->
    (match b
      Obs bx by _ ->
      (band (int-eq ax bx) (int-eq ay by)))))

(define (obs-alive obs)
  (match obs Obs _ _ alive -> alive))

;; Apply an action to an observable
(define (do-action obs act)
  (match obs
    Obs x y alive ->
    (ife alive
      (match act
        U -> (Obs x (succ y) (T))
        D -> (Obs x (pred y) (T))
        R -> (Obs (succ x) y (T))
        L -> (Obs (pred x) y (T))
        Despawn -> (Obs x y (F))
        X -> (Obs x y (T)))
      obs)))

;; Current observable of a state
(define (cur-obs st)
  (match st
    St slices ->
    (match (hd slices) Sc _ _ obs -> obs)))

;; Is a cell occupied by any alive state?
(define (occupied pos sts)
  (any-of
    (fn st ->
      (let ((obs (cur-obs st)))
        (band (obs-alive obs) (pos-eq pos obs))))
    sts))

;; Was an object heading toward a target position?
(define (heading-toward other-obs act target-obs)
  (pos-eq (do-action other-obs act) target-obs))

;; Step a single state forward given its kind
(define (step-st kind st all-sts)
  (match st
    St slices ->
    (match (hd slices)
      Sc plat _ pobs ->
      (match kind
        Kd nextlat nextact ->
        (let ((new-lat (nextlat plat pobs all-sts))
              (act (nextact new-lat))
              (new-obs (do-action pobs act)))
          (St (Co (Sc new-lat act new-obs) slices)))))))

;; Step all states forward given their kinds
(define (step-sts kinds sts all-sts)
  (match kinds
    Ni -> (Ni)
    Co kind ks ->
    (match sts
      Co st rest ->
      (Co (step-st kind st all-sts)
          (step-sts ks rest all-sts)))))

;; Step the whole setup forward one timestep
(define (step setup)
  (match setup
    Setup kinds sts ->
    (Setup kinds (step-sts kinds sts sts))))

;; Run t timesteps
(define (run t setup)
  (match t
    Z -> setup
    P t' -> (run t' (step setup))))

;;;; kinds

;; Wall: stays put, ignores everything
(define wall-kind
  (Kd (fn lat obs objs -> lat)
      (fn lat -> (X))))

;; Horizontal bouncer: Lat dir _ _
(define bouncer-kind
  (Kd (fn lat obs objs ->
        (match lat
          Lat dir b c ->
          (let ((ahead (do-action obs (ife dir (R) (L)))))
            (ife (occupied ahead objs)
              (Lat (bnot dir) b c)
              lat))))
      (fn lat ->
        (match lat Lat dir _ _ -> (ife dir (R) (L))))))

;; Alternating bouncer: Lat hdir vdir hturn
(define alt-bouncer-kind
  (Kd (fn lat obs sts ->
        (match lat
          Lat hdir vdir hturn ->
          (ife hturn
            (let ((act (ife hdir (R) (L)))
                  (blocked (occupied (do-action obs act) sts)))
              (Lat (ife blocked (bnot hdir) hdir) vdir (F)))
            (let ((act (ife vdir (U) (D)))
                  (blocked (occupied (do-action obs act) sts)))
              (Lat hdir (ife blocked (bnot vdir) vdir) (T))))))
      (fn lat ->
        (match lat
          Lat hdir vdir hturn ->
          (ife hturn
            (ife hdir (R) (L))
            (ife vdir (U) (D)))))))

;; Water: Lat down-free left-free right-free
(define water-kind
  (Kd (fn lat obs sts ->
        (Lat (bnot (occupied (do-action obs (D)) sts))
             (bnot (occupied (do-action obs (L)) sts))
             (bnot (occupied (do-action obs (R)) sts))))
      (fn lat ->
        (match lat
          Lat down-free left-free right-free ->
          (ife down-free
            (D)
            (ife left-free
              (ife right-free
                (if (flip 0.5) (L) (R))
                (L))
              (ife right-free
                (R)
                (X))))))))

;; Breakable block: despawns when an adjacent alive object was heading toward it
;; Lat hit _ _
(define block-kind
  (Kd (fn lat obs sts ->
        (let ((hit (any-of
                     (fn st ->
                       (match st St slices ->
                       (match (hd slices) Sc _ act other-obs ->
                       (band (obs-alive other-obs)
                             (band (bnot (pos-eq other-obs obs))
                                   (heading-toward other-obs act obs))))))
                     sts)))
          (Lat hit (F) (F))))
      (fn lat ->
        (match lat Lat hit _ _ ->
          (ife hit (Despawn) (X))))))
