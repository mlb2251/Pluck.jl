
;; playing with type inference

(define-type my-type
    (MyNat)
    (MyList my-type)
)

(define (type-size t)
    (match t
        MyNat => 1
        MyList t => (S (type-size t))
    )
)

(define (rand-mytype)
    (if (flip 0.5)
        (MyNat)
        (MyList (rand-mytype))))


;; typeof is a little unusual - it gives a distribution over types!
(define (typeof x) (match x
    S _ => (MyNat)
    O => (MyNat)
    Cons x _ => (MyList (typeof x))
    Nil => (MyList (rand-mytype))
))



(define (rand-myvalue type)
    (match type
        MyNat => (if (flip 0.5) 0 (S (rand-myvalue (MyNat))))
        MyList t => (if (flip 0.5) (Nil) (Cons (rand-myvalue t) (rand-myvalue (MyList t))))))



;; (define (type-checks x t)


(define (my-add a b) (match a
    S n => (S (my-add n b))
    O => (match b ;; silly branch just to make sure it's a Nat
        S _ => b
        O => b)))

(define (my-map f l) (match l
    Nil => (Nil)
    Cons x xs => (Cons (f x) (my-map f xs))))

(assert-query
 'my-add-4-5
 (Marginal
  (my-add 4 5))
 (9 1.0))

(assert-query
 'my-map-double
 (Marginal
  (my-map (fn x -> (my-add x x)) [1 2 3 4 5]))
 ([2 4 6 8 10] 1.0))

(assert-query
 'rand-mytype-eq
 (Marginal
  (=? (rand-mytype) (MyList (MyList (MyNat)))))
 ((False) 0.875)
 ((True) 0.125))

