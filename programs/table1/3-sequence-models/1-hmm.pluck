;; HMM benchmark
;; Translated from PluckArtifact.jl/src/table1/sequence_models/pluck/hmm.jl

(define hmm
  (Y (λ rec z0 ->
    (let (z1 (flip (if z0 0.7 0.1)))
      (Cons (flip (if z1 0.3 0.6)) (rec z1))))))

(define prefix_equals?
  (Y (λ rec xs ys ->
    (case ys of Nil => true |
                Cons yhd ytl => (case xs of Nil => false |
                                            Cons xhd xtl => (and (constructors_equal xhd yhd) (rec xtl ytl)))))))

(define generate_observations
  (Y (λ rec n -> (case n of O => (Nil) | S => (λ npred -> (Cons (True) (rec npred)))))))

;; Query: (hmm_example 50) = (prefix_equals? (hmm (False)) (generate_observations 50))
(assert-query
  'hmm
  (Marginal
    (prefix_equals? (hmm (False)) (generate_observations 50)))
  ((False) 0.9999999999998197)
  ((True) 1.802995485540675e-13))
