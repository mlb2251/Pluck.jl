;; String editing benchmark
;; Translated from PluckArtifact.jl/src/table1/sequence_models/pluck/string_editing.jl

;; Original: Pluck.define_type!(:Char, Dict(Symbol("$(a)_") => Symbol[] for a = 'a':'e'))
(define-type Char (a_) (b_) (c_) (d_) (e_))

;; Original: make_uniform(CHARACTERS) — uniform over 5 chars via nested flips
(define (random_char)
  (uniform (a_) (b_) (c_) (d_) (e_)))

(define strings_eq
  (Y (fn strings_eq l1 l2 -> (match l1
    Nil => (match l2 Nil => true | Cons _ _ => false)
    Cons c1 c2 => (match l2 Nil => false | Cons c3 c4 => (and (constructors_equal c1 c3) (strings_eq c2 c4)))
  ))))

(define random_string
  (Y (fn random_string p ->
    (if (flip p)
      []
      (Cons (random_char) (random_string p))
    )
  )))

;; note during artifact construction: this is the one we're using
(define perturb
  (Y (fn perturb s ->
      (match s
        Nil => (random_string 0.99)
        Cons c cs =>
        (let
          (do_delete (flip 0.01)
           insertion (random_string 0.99)
           perturbed_cs (perturb cs))
          (if do_delete
              perturbed_cs
              (append insertion (Cons (if (flip 0.01) (random_char) c) perturbed_cs))
              ))))))

;; Query: string_editing_query(4, 5) =
;;   (strings_eq (perturb <long_string_1[1:4]>) <long_string_2[1:5]>)
;; long_string_1[1:4] = "edcc"
;; long_string_2[1:5] = "eddde"
(assert-query
  'string-editing
  (Marginal
    (strings_eq
      (perturb [(e_) (d_) (c_) (c_)])
      [(e_) (d_) (d_) (d_) (e_)]))
  ((False) 0.9999999703333271)
  ((True) 2.9666673058148367e-8))
