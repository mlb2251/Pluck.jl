;; PCFG benchmark
;; Translated from PluckArtifact.jl/src/table1/sequence_models/pluck/pcfg.jl

;; Original: Pluck.define_type!(:pcfg_grammar_symbol Dict(:SS -> Symbol[] :XX -> Symbol[] :YY -> Symbol[] :A -> Symbol[] :B -> Symbol[] :C -> Symbol[]))
(define-type pcfg_grammar_symbol (SS) (XX) (YY) (A) (B) (C))

(define (generate_pcfg_grammar symbol)
  (match symbol
    SS -> (let ((xgen (generate_pcfg_grammar ( XX ))) (ygen (generate_pcfg_grammar (YY))) (order (flip 0.5)))
      (if order (append xgen ygen) (append ygen xgen)))
    XX -> (if (flip 0.5) [(A)] (Cons (B) (append (generate_pcfg_grammar (XX)) (generate_pcfg_grammar (XX)))))
    YY -> (Cons (C) (if (flip 0.5) [] (generate_pcfg_grammar (if (flip 0.5) (XX) (SS)))))
  ))

(define symbol_equals
  (fn symbol1 symbol2 ->
    (match symbol1
      A -> (match symbol2
        A -> true
        B -> false
        C -> false)
      B -> (match symbol2
        A -> false
        B -> true
        C -> false)
      C -> (match symbol2
        A -> false
        B -> false
        C -> true)
    )
  ))

(define (list_symbols_equal list1 list2)
  (match list1
    Nil -> (match list2
      Nil -> true
      Cons _ _ -> false)
    Cons hd1 tl1 -> (match list2
      Nil -> false
      Cons hd2 tl2 -> (and (symbol_equals hd1 hd2) (list_symbols_equal tl1 tl2)))
  ))

;; Query: pcfg_query() =
;;   (list_symbols_equal (generate_pcfg_grammar (SS)) <test_example_string>)
;; test_example_string = [:c :b :b :b :a :b :b :a :b :a :b :b :a :b :a :a :a :a :a :b :a :a :a]
(assert-query
  'pcfg
  (Marginal
    (list_symbols_equal
      (generate_pcfg_grammar (SS))
      [(C) (B) (B) (B) (A) (B) (B) (A) (B) (A) (B) (B) (A) (B) (A) (A) (A) (A) (A) (B) (A) (A) (A)]))
  ((False) 0.9999999701976776)
  ((True) 2.9802322387695312e-8))
