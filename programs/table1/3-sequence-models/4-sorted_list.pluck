;; Sorted list benchmark
;; Translated from PluckArtifact.jl/src/table1/sequence_models/pluck/sorted_list.jl

(define (nats_equal m n)
  (match m
    O -> (match n O -> true  S npred -> false)
    S mpred -> (match n O -> false  S npred -> (nats_equal mpred npred))))

(define (nat_lists_equal xs ys)
  (match xs
    Nil -> (match ys Nil -> true  Cons yhd ytl -> false)
    Cons xhd xtl -> (match ys Nil -> false  Cons yhd ytl -> (and (nats_equal xhd yhd) (nat_lists_equal xtl ytl)))))

(define random_num_larger_than
  (fn min -> (+ (randnat) min)))

(define (generate_sorted_list min)
  (if (flip 0.5) [] (let ((m (random_num_larger_than min))) (Cons m (generate_sorted_list m)))))


;; Query: sorted_list_query() =
;;   (nat_lists_equal (generate_sorted_list (O)) <pluck_list([0, 3, 7, 12, 13, 15, 16, 20])>)
(assert-query
  'sorted-list
  (Marginal
    (nat_lists_equal
      (generate_sorted_list (O))
      [0 3 7 12 13 15 16 20]))
  ((False) 0.999999999992724)
  ((True) 7.275957614183426e-12))



(define (random_num_larger_than_fuel fuel min)
  (match fuel
  S fuel ->
    (if (flip 0.5)
      min
      (S (random_num_larger_than_fuel fuel min)))))

(define (generate_sorted_list_fuel fuel fuel_num min)
  (match fuel
  S fuel ->
      (if (flip 0.5) [] (let ((m (random_num_larger_than_fuel fuel_num min))) (Cons m (generate_sorted_list_fuel fuel fuel_num m))))))



