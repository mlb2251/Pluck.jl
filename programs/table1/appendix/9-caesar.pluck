;; Caesar cipher inference
;; Adapted from the Dice artifact

(define-type Char (A_) (B_) (C_) (D_))

(define (random_key)
  (if (flip 0.25)
    (A_)
    (if (flip 0.33333)
      (B_)
      (if (flip 0.5)
        (C_)
        (D_)))))

(define (random_char)
  (if (flip 0.5)
    (A_)
    (if (flip 0.5)
      (B_)
      (if (flip 0.5)
        (C_)
        (D_)))))

(define (strings_eq l1 l2)
  (match l1
    Nil -> (match l2 Nil -> true  Cons _ _ -> false)
    Cons c1 c2 -> (match l2 Nil -> false  Cons c3 c4 -> (and (constructors_equal c1 c3) (strings_eq c2 c4)))))

(define char_to_num (fn c -> (match c A_ -> 0  B_ -> 1  C_ -> 2  D_ -> 3)))

(define (rotate_char n c)
  (match n
    O -> c
     S m -> (rotate_char m (match c
      A_ -> (B_)
      B_ -> (C_)
      C_ -> (D_)
      D_ -> (A_)))))

(define encrypt_message
  (fn key message -> (map (fn c -> (rotate_char key c)) message)))

(define (random_string n)
  (match n O -> []  S m -> (Cons (random_char) (random_string m))))

(define caesar
  (fn observed -> (let
    (key (random_key)
     msg (random_string (length observed))
     encrypted (encrypt_message (char_to_num key) msg))
    (Pair key (strings_eq observed encrypted)))))

(assert-query
  'caesar-posterior
  (let (result (caesar [(C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_)]))
    (Posterior (fst result) (snd result)))
  ((B_) 7.888490723665978e-31)
  ((A_) 6.222984162940327e-61)
  ((D_) 6.223015277861142e-61)
  ((C_) 1.0))

(define caesar_given
  (fn observed -> (let
    (key (random_key)
     msg (random_string (length observed))
     encrypted (encrypt_message (char_to_num key) msg))
    (given (strings_eq observed encrypted) key))))

(assert-query
  'caesar-given
  (NormalizedMarginal
    (caesar_given [(C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_) (C_)]))
  ((B_) 7.888490723665978e-31)
  ((A_) 6.222984162940327e-61)
  ((D_) 6.223015277861142e-61)
  ((C_) 1.0))
