;; Classic example from Judea Pearl's Causality book
;; Adapted from https://github.com/SHoltzen/dice/blob/master/benchmarks/baselines/grass.dice

(assert-query
  'grass-posterior
  (let (cloudy (flip 0.5)
        rain (flip (if cloudy 0.8 0.2))
        sprinkler (flip (if cloudy 0.1 0.5))
        temp1 (flip 0.7)
        wetRoof (and temp1 rain)
        temp2 (flip 0.9)
        temp3 (flip 0.9)
        wetGrass (or (and temp2 rain) (and temp3 sprinkler)))
    (Posterior rain wetGrass))
  ((False) 0.29207232267037553)
  ((True) 0.7079276773296245))

(assert-query
  'grass-given
  (NormalizedMarginal
    (let (cloudy (flip 0.5)
          rain (flip (if cloudy 0.8 0.2))
          sprinkler (flip (if cloudy 0.1 0.5))
          temp1 (flip 0.7)
          wetRoof (and temp1 rain)
          temp2 (flip 0.9)
          temp3 (flip 0.9)
          wetGrass (or (and temp2 rain) (and temp3 sprinkler)))
      (given wetGrass rain)))
  ((False) 0.29207232267037553)
  ((True) 0.7079276773296245))
