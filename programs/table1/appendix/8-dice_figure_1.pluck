;; From Dice Figure 1
;; Iterates a noisy boolean channel 100 times

(define dice_figure_1_fn
  (Y (λ rec x n -> (case n of O => x | S => (λn ->
    (let ((x2 (if x (flip 0.2) (flip 0.3))))
      (rec x2 n)))))))

(assert-query
  'dice-figure-1-default
  (Marginal
    (dice_figure_1_fn (flip 0.5) 100))
  ((False) 0.7272727272727271)
  ((True) 0.2727272727272725))
