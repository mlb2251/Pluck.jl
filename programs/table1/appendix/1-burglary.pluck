;; Classic example from Judea Pearl's Causality book
;; Adapted from https://github.com/SHoltzen/dice/blob/master/benchmarks/baselines/alarm.psi

(assert-query
  'burglary-default
  (let (earthquake   (flip 0.0001)
        burglary     (flip 0.001)
        alarm        (or earthquake burglary)
        phoneWorking (flip (if earthquake 0.7 0.99))
        maryWakes    (flip (if alarm (if earthquake 0.8 0.6) 0.2))
        called       (and maryWakes phoneWorking))
    (Posterior burglary called))
  ((False) 0.9970065507586944)
  ((True) 0.0029934492413055437))

(assert-query
  'burglary-given
  (NormalizedMarginal
    (let (earthquake   (flip 0.0001)
          burglary     (flip 0.001)
          alarm        (or earthquake burglary)
          phoneWorking (flip (if earthquake 0.7 0.99))
          maryWakes    (flip (if alarm (if earthquake 0.8 0.6) 0.2))
          called       (and maryWakes phoneWorking))
      (given called burglary)))
  ((False) 0.9970065507586944)
  ((True) 0.0029934492413055437))
