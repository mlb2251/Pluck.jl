(define (mkSortedList n)
  (if (flip 0.5)
    []
    (let ((x (+ n (geom 0.5))))
      (Cons x (mkSortedList x)))))

(assert-query
 'first-two-elements-are-zero
 (Marginal
  (list=? nat=?
          (take 2 (mkSortedList 0))
          [0 0]))
 ((False) 0.9375)
 ((True) 0.0625))

(assert-query
 'second-element-given-first-and-third
 (let ((xs (mkSortedList 0)))
   (Posterior
    (index 1 xs)
    (and (nat=? (index 0 xs) 2)
         (nat=? (index 2 xs) 5))))
 (2 0.25)
 (3 0.25)
 (4 0.25)
 (5 0.25))
