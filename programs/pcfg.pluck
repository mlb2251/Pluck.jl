;; (define-type non-terminal (Start) (XX) (YY))
;; (define-type terminal (A_) (B_) (C_))

(define (generate nt)
  (match nt
    Start -> (uniform
              (append (generate (XX)) (generate (YY)))
              (append (generate (YY)) (generate (XX))))
    XX -> (uniform
           [(A_)]
           (Cons (B_) (append (generate (XX)) (generate (XX)))))
    YY -> (Cons (C_) (uniform
                      []
                      (generate (XX))
                      (generate (Start))))))

(define string=? (list=? constructor=?))

;; test_example_string =
;; [:c :b :b :b :a
;; :b :b :a :b :a
;; :b :b :a :b :a
;; :a :a :a :a :b
;; :a :a :a]
(assert-query
 'probability-of-string
 (Marginal
  (string=? (generate (Start))
            [(C_) (B_) (B_) (B_) (A_) (B_) (B_) (A_) (B_) (A_) (B_) (B_) (A_) (B_) (A_) (A_) (A_) (A_) (A_) (B_) (A_) (A_) (A_)]))
 ((False) 0.9999999602635702)
 ((True) 3.973642985224724e-8))

;; What could the string be if it is 5 or fewer letters long
;; and the third letter is an a?
(assert-query
 'posterior-on-strings
 (let ((s (generate (Start))))
   (Posterior
    s
    (and (> 6 (length s)) (constructor=? (index 2 s) (A_)))))
 ([(A_) (C_) (A_)] 0.250000000003125)
 ([(C_) (A_) (A_)] 0.250000000003125)
 ([(B_) (A_) (A_) (C_)] 0.1250000000015625)
 ([(C_) (B_) (A_) (A_)] 0.1250000000015625)
 ([(B_) (A_) (A_) (C_) (A_)] 0.06250000000078125)
 ([(C_) (B_) (A_) (A_) (A_)] 0.06250000000078125)
 ([(A_) (C_) (A_) (C_)] 0.04166666666302083)
 ([(C_) (C_) (A_) (A_)] 0.04166666666302083)
 ([(A_) (C_) (A_) (C_) (A_)] 0.020833333331510415)
 ([(C_) (C_) (A_) (A_) (A_)] 0.020833333331510415))

;; Simple English PCFG
;; (define-type non-terminal (Sent) (NP) (VP) (Verb) (VT) (Det) (Adj) (Noun) (Conj))
;; (define-type terminal (The_) (A_) (Cat_) (Dog_) (Barks_) (Eats_) (Bone_) (Happy_) (Sad_) (Tasty_) (And_) (But_))

(define (generate-english nt)
  (match nt
    Sent -> (discrete
             ((append (generate-english (NP)) (generate-english (VP))) 0.7)
             ((append (append (generate-english (NP)) (generate-english (VP)))
                      (append (generate-english (Conj)) (generate-english (Sent)))) 0.3))
    Conj -> [(uniform (And_) (But_))]
    NP -> (append (generate-english (Det)) (generate-english (Noun)))
    VP -> (uniform (generate-english (Verb)) (append (generate-english (VT)) (generate-english (NP))))
    Verb -> [(uniform (Barks_) (Eats_))]
    VT -> [(Eats_)]
    Adj -> [(uniform (Happy_) (Sad_) (Tasty_))]
    Det -> [(uniform (The_) (A_))]
    Noun -> (discrete ((append (generate-english (Adj)) (generate-english (Noun))) 0.3)
                      ([(uniform (Cat_) (Dog_) (Bone_))] 0.7))))

(assert-query
 'probability-of-sentence
 (Marginal
  (string=? (generate-english (Sent))
            [(The_) (Dog_) (Eats_) (The_) (Bone_)]))
 ((False) 0.9952361111113492)
 ((True) 0.004763888888650694))

(assert-query
 'short-sentence
 (let ((s (generate-english (Sent))))
   (Posterior
    s
    (>= 3 (length s))))
 ([(A_) (Cat_) (Barks_)] 0.08333333333750001)
 ([(A_) (Cat_) (Eats_)] 0.08333333333750001)
 ([(A_) (Dog_) (Barks_)] 0.08333333333750001)
 ([(A_) (Dog_) (Eats_)] 0.08333333333750001)
 ([(The_) (Cat_) (Barks_)] 0.08333333333750001)
 ([(The_) (Cat_) (Eats_)] 0.08333333333750001)
 ([(The_) (Dog_) (Barks_)] 0.08333333333750001)
 ([(The_) (Dog_) (Eats_)] 0.08333333333750001)
 ([(A_) (Bone_) (Barks_)] 0.08333333332500001)
 ([(A_) (Bone_) (Eats_)] 0.08333333332500001)
 ([(The_) (Bone_) (Barks_)] 0.08333333332500001)
 ([(The_) (Bone_) (Eats_)] 0.08333333332500001))

(assert-query
 'infilling-given-fifth-word-tasty
 (let ((s (generate-english (Sent))))
   (Posterior
    s
    (and
     (<= (length s) 7)
     (constructor=? (index 4 s) (Tasty_)))))
