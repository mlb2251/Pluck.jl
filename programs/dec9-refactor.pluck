;; Test file for define builtin
;; Testing that (define 'name expr) works as a builtin

;; For toplevel definitions, still use the regular syntax:
(define x 5)
(define y (+ 3 2))
;; Now we can use the define builtin with nice syntax!

(query (Marginal (define (myadd a b) (+ a b))))

;; Test that regular toplevel defines still work
(query 'test-x (Marginal x))
(query 'test-y (Marginal y))
(query 'test-add (Marginal (myadd 10 20)))

;; Test 1: Basic define builtin - force evaluation by matching on the Unit result
(query 'test-define-builtin
  (match (define z 42)
    Unit => (Marginal (lookup 'z))))

;; Test 2: Define function using the builtin with new syntax!
(query 'test-define-function
  (match (define (multiply a b) (* a b))
    Unit => (let ((mult (lookup 'multiply)))
              (Marginal (mult 6 7)))))

;; Test 3: Conditional define - the key use case for this builtin!
(query 'test-conditional-define
  (let ((coin (flip 0.5)))
    (match (if coin
             (define result 100)
             (define result 200))
      Unit => (Marginal (lookup 'result)))))

;; Test 4: Define based on computed value
(query 'test-computed-define
  (let ((value (+ 10 20)))
    (match (define computed value)
      Unit => (Marginal (lookup 'computed)))))
