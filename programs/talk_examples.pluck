;; load_pluck_file("programs/talk_examples.pluck");


(define (talk-randbool) (flip 0.5))
(define (talk-randnat) (if (flip 0.5) 0 (S (talk-randnat))))
(define (talk-randnatlist) (if (flip 0.5) [] (Cons (talk-randnat) (talk-randnatlist))))

(define (talk-inputs-1) [3 7 2 6])
(define (talk-outputs-1) [4 8 1 5])
(define (talk-inputs-2) [1 8 6 5 7])
(define (talk-outputs-2) [2 7 5 6 8])

(define (talk-hypothesis-1) (fn xs -> (talk-randnatlist)))
(define (talk-hypothesis-2) (fn xs -> (map (fn x -> (talk-randnat)) xs)))
(define (talk-hypothesis-3) (fn xs -> (map (fn x -> (if (talk-randbool) (inc x) (talk-randnat))) xs)))
(define (talk-hypothesis-4) (fn xs -> (map (fn x -> (if (talk-randbool) (inc x) (dec x))) xs)))
(define (talk-hypothesis-5) (fn xs -> (map (fn x -> (if (isodd x) (inc x) (dec x))) xs)))

(define (talk-hypothesis-alt-1) (fn xs -> (filter (fn x -> (talk-randbool)) xs)))
(define (talk-hypothesis-alt-2) (fn xs -> (Cons (talk-randnat) (talk-randnatlist))))


(define (talk-evaluate program)
    (and (list=? nat=? (program (talk-inputs-1)) (talk-outputs-1))
         (list=? nat=? (program (talk-inputs-2)) (talk-outputs-2))))

(assert-query
 'talk-hypothesis-1
 (Marginal
  (talk-evaluate (talk-hypothesis-1)))
 ((False) 1.0)
 ((True) 1.3552527156068805e-20))

(assert-query
 'talk-hypothesis-2
 (Marginal
  (talk-evaluate (talk-hypothesis-2)))
 ((False) 1.0)
 ((True) 2.7755575615628914e-17))

(assert-query
 'talk-hypothesis-3
 (Marginal
  (talk-evaluate (talk-hypothesis-3)))
 ((False) 0.9999999994534107)
 ((True) 5.465893523925493e-10))

(assert-query
 'talk-hypothesis-4
 (Marginal
  (talk-evaluate (talk-hypothesis-4)))
 ((False) 0.998046875)
 ((True) 0.001953125))

(assert-query
 'talk-hypothesis-5
 (Marginal
  (talk-evaluate (talk-hypothesis-5)))
 ((True) 1.0))

(assert-query
 'talk-hypothesis-alt-1
 (Marginal
  (talk-evaluate (talk-hypothesis-alt-1)))
 ((False) 1.0))

(assert-query
 'talk-hypothesis-alt-2
 (Marginal
  (talk-evaluate (talk-hypothesis-alt-2)))
 ((False) 1.0)
 ((True) 5.421010862427522e-20))
